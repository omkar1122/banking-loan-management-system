<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ taglib uri="jakarta.tags.fmt" prefix="fmt" %>
<%@ taglib uri="jakarta.tags.functions" prefix="fn" %>
<%@ taglib uri="http://www.springframework.org/tags/form" prefix="form" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NovaBank - Banking &amp; Loan Management</title>
  <link rel="stylesheet" href="${ctx}/css/style.css">
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script>var CTX = '${ctx}';</script>
  <script src="${ctx}/js/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <div class="brand">NovaBank</div>
  <nav>
    <a href="${ctx}/">Dashboard</a>
    <a href="${ctx}/customers">Customers</a>
    <a href="${ctx}/branches">Branches</a>
    <a href="${ctx}/accounts">Accounts</a>
    <a href="${ctx}/accounts/balance">Balance</a>
    <a href="${ctx}/transactions/deposit">Deposit</a>
    <a href="${ctx}/transactions/withdraw">Withdraw</a>
    <a href="${ctx}/transactions/transfer">Transfer</a>
    <a href="${ctx}/loans/apply">Apply Loan</a>
    <a href="${ctx}/loans/applications">Approvals</a>
    <a href="${ctx}/loans">Loans</a>
    <a href="${ctx}/loans/types">Loan Types</a>
    <a href="${ctx}/reports/branch-totals">Reports</a>
  </nav>
</header>
<main class="container">
<c:if test="${not empty flashSuccess}"><div class="alert success"><c:out value="${flashSuccess}"/></div></c:if>
<c:if test="${not empty flashError}"><div class="alert error"><c:out value="${flashError}"/></div></c:if>
